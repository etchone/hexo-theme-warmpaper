<article class="post-card">
  <h2 class="post-card-title">
    <a href="<%- url_for(post.path) %>"><%= post.title || '(Untitled)' %></a>
  </h2>
  <div class="post-card-meta">
    <time datetime="<%- date_xml(post.date) %>"><%- date(post.date, 'YYYY-MM-DD') %></time>
    <% if (post.categories && post.categories.length) { %>
      <span class="separator">&middot;</span>
      <% post.categories.each(function(cat){ %>
        <a href="<%- url_for(cat.path) %>"><%= cat.name %></a>
      <% }) %>
    <% } %>
  </div>
  <div class="post-card-excerpt">
    <% if (post.excerpt) { %>
      <%- post.excerpt %>
    <% } else {
      function excerptShortest(text, charLimit = 200, lineLimit = 4) {
        function getFirstLines(text, maxLines) {
          const lineTagRe = /<\/p>|<br\s*\/?>/gi;
          let match;
          let lineCount = 0;

          while ((match = lineTagRe.exec(text)) !== null) {
            lineCount++;
            if (lineCount === maxLines) {
              return text.slice(0, match.index);
            }
          }
          // 总行数不超过 maxLines，直接返回全文
          return text;
        }

        const hrMatch = text.match(/<hr[^>]*?>/);
        if (hrMatch) {
          text = text.substring(0, hrMatch.index);
        }

        const byChars = text.slice(0, charLimit);
        const byLines = getFirstLines(text, lineLimit);

        // 返回长度更短的那个
        const shorter = byChars.length <= byLines.length ? byChars : byLines;
        const suffix = (!hrMatch && strip_html(shorter) == strip_html(text)) ? '' : '<p>...</p>';
        return shorter + suffix;
      }
      %>
      <p><%- excerptShortest(post.content, theme.excerptCharLimit||200, theme.excerptLineLimit||4) %></p>
    <% } %>
  </div>
  <a class="read-more" href="<%- url_for(post.path) %>"><%= theme.excerpt_link || 'Read More' %></a>
  <% if (post.tags && post.tags.length) { %>
    <div class="post-card-tags">
      <% post.tags.each(function(tag){ %>
        <a href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
      <% }) %>
    </div>
  <% } %>
</article>
